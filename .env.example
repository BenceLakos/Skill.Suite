# Copy to .env beside compose.production.yaml and fill in. .env is gitignored: the whole point of these being
# environment variables is that the credential which can rewrite marks never lives in the repository.
#
#   cp .env.example .env && $EDITOR .env
#   docker compose -f compose.yaml -f compose.production.yaml up -d

# Base name for the Traefik routes; this stack is published at suite.<domain>. Must match DOMAIN in infra/.env.
DOMAIN=skills.local

# The platform image to run, e.g. localhost:3000/admin/skill-suite:sha-4ed0bd9. The deploy job of
# .gitea/workflows/publish-image.yml passes the one it just built; from a shell, leave it empty to build locally.
SKILLSUITE_IMAGE=

# Seeded on FIRST BOOT ONLY. Must satisfy the production password policy in appsettings.json:
# 12+ characters, upper, lower, digit, symbol, 4 distinct characters.
SKILLSUITE_ADMIN_USER=admin
SKILLSUITE_ADMIN_PASSWORD=

# The git host as the application reaches it over the container network.
SKILLSUITE_GIT_INTERNAL_URL=http://gitea:3000

# This application as the GIT HOST reaches it. Written into every competitor webhook at session start; wrong
# here is silent — repositories provision, hooks install, no push ever arrives.
SKILLSUITE_WEBHOOK_URL=http://skill-suite:8080/webhooks/git

# The authored sessions live in the docker volume skill-suite-starter-packages, mounted at /starter-packages,
# which is the path prefix a session's template folder must use. Fill it from the Starter packages page in the
# UI, or with scripts/starter-packages.sh push judging/samples/fibonacci-session. No host path is involved, so
# the deploy job needs nothing from here for it.

# The docker network Traefik reaches this application from, in CIDR form — the only peer allowed to say who
# the client is. Set it and the sign-in page fills in a competitor's credentials when the request comes from
# the workstation address recorded against them; leave it empty and every request looks like it came from the
# proxy, so nothing is ever pre-filled.
#
# Empty is the safe default on purpose: trusting X-Forwarded-For from anywhere else lets anyone who can reach
# the port claim to be at any workstation, which is the same as asking the server for that competitor's
# password. Find the subnet docker assigned with:
#   docker network inspect skill-suite --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
SKILLSUITE_TRUSTED_PROXY_NETWORK=

# Judge container caps. Size for the machine; a black-box session runs mutation testing and needs headroom.
SKILLSUITE_JUDGE_MEMORY=4g
SKILLSUITE_JUDGE_CPUS=2
SKILLSUITE_JUDGE_PIDS=512
SKILLSUITE_CONCURRENT_RUNS=2

# Bind address for the UI. Narrow this to the operator subnet if the venue network is shared with competitors.
SKILLSUITE_BIND=0.0.0.0
