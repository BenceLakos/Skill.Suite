# Copy to infra/.env and fill in. infra/.env is gitignored; nothing here is secret except the dashboard
# credential and the SQL Server sa password, which is why those two are required rather than defaulted.
#
# Compose reads this file because the project directory is the directory of the first -f file, so
# `docker compose -f infra/compose.yaml ...` picks up infra/.env from any working directory.
#
# Order of operations on a fresh competition machine:
#
#   1. cp infra/.env.example infra/.env && $EDITOR infra/.env
#   2. docker compose -f infra/compose.yaml up -d
#   3. create the admin user in the Gitea UI at http://git.<domain>/
#      (the runners restart-loop until step 4; that is expected)
#   4. infra/runner-token.sh
#   5. docker compose -f infra/compose.yaml up -d          # recreates the runners with the token
#   6. scripts/gitea-push.sh --url http://git.<domain> --token "$GITEA_TOKEN"

# The base name everything hangs off. Every device that should reach the stack must resolve git.<domain>,
# suite.<domain>, sql.<domain> and traefik.<domain> to THIS HOST'S LAN IP - a wildcard record on the venue
# router's DNS is the least painful way, an /etc/hosts line on each machine the fallback. The host itself
# needs them too if it will `docker pull` from the registry or open a SQL client. Left unset everything falls
# back to *.localhost, which browsers resolve to loopback, so a single-machine setup works with no .env at all.
DOMAIN=skills.local

# The port Traefik publishes on the host. 80 is the point of the exercise; change it only if something else
# on the machine already owns it.
TRAEFIK_HTTP_PORT=80

# REQUIRED. htpasswd line(s) guarding the Traefik dashboard at http://traefik.<domain>/. Generate one with:
#
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'change-me'
#
# IMPORTANT: wrap the value in SINGLE QUOTES here, e.g.
#   TRAEFIK_DASHBOARD_USERS='admin:$2y$05$4Zz...'
# A bcrypt hash is $-separated and compose interpolates $ inside unquoted .env values, so an unquoted hash is
# silently mangled into something no password matches. Several users are comma-separated inside the quotes.
TRAEFIK_DASHBOARD_USERS=

# Written by infra/runner-token.sh, which asks the running Gitea for a fresh registration token. Leave it
# empty on the first `up -d`.
GITEA_RUNNER_REGISTRATION_TOKEN=

# How many act_runner replicas to run, 1..20. Each runner takes ONE job at a time, so this is the number of
# workflow jobs that can build in parallel. Size it against CPU and RAM rather than against optimism: a
# platform image build is a full .NET restore + publish, and twenty of them on one machine will swap.
GITEA_RUNNER_REPLICAS=1

# What a `runs-on:` value maps to. The default gives workflows `ubuntu-latest`, executed in Gitea's runner
# image, which already carries git, node and the common actions' dependencies.
GITEA_RUNNER_LABELS=ubuntu-latest:docker://gitea/runner-images:ubuntu-latest

# How the runner reaches Gitea. The docker network name, not the public one: it is shorter-lived DNS, it
# avoids a round trip through Traefik for every job poll, and what a workflow sees as github.server_url comes
# from Gitea's ROOT_URL regardless of this.
GITEA_RUNNER_INSTANCE_URL=http://gitea:3000

# --- SQL Server --------------------------------------------------------------------------------------------
# Competitors connect with a login and database of their own, never sa:
#
#   Server=sql.<domain>,1433;Database=<competitor>;User Id=<competitor>;Password=...;TrustServerCertificate=True
#
# TrustServerCertificate is needed because the server presents a self-signed certificate and there is no CA
# on the LAN to have signed a real one. Traefik forwards the TCP stream untouched, so the same string works
# from a laptop, from the host and from a container on the skill-suite network.
#
# There is no init-script hook in the SQL Server image, so the logins are created by hand once the server is
# healthy - as sa, from the host - and then entered into the platform as Microsoft SQL Server credentials.
# ALTER AUTHORIZATION makes the login the owner of its own database and nothing else:
#
#   docker exec -it -e SQLCMDPASSWORD="$MSSQL_SA_PASSWORD" skill-suite-mssql /opt/mssql-tools18/bin/sqlcmd -U sa -C
#   CREATE LOGIN c01 WITH PASSWORD = 'per-competitor-secret', CHECK_POLICY = ON;
#   CREATE DATABASE c01;
#   ALTER AUTHORIZATION ON DATABASE::c01 TO c01;
#   GO

# REQUIRED. The operator's sa password. SQL Server enforces its own policy on it and REFUSES TO START when the
# value fails it: at least 8 characters, from at least three of upper case, lower case, digits and symbols.
# The failure is only visible in `docker logs skill-suite-mssql` - compose sees a container that keeps
# restarting. Wrap the value in SINGLE QUOTES if it contains a $, for the same interpolation reason as the
# dashboard hash above.
#
# FIRST BOOT ONLY. The image reads this while the mssql-data volume is empty; afterwards the password lives in
# master.mdf and the variable is ignored by the engine - but NOT by the healthcheck, which reads it from the
# container. Changing it here and running `up -d` therefore leaves the server on the old password and turns
# the container "unhealthy" while clients still connect fine. To rotate: change it on the server first, then
# here, then `up -d`:
#
#   ALTER LOGIN sa WITH PASSWORD = 'new-secret' OLD_PASSWORD = 'old-secret';
MSSQL_SA_PASSWORD=

# Edition, through the product id the image understands: Express, Developer, Standard, Enterprise, or a
# licence key. Express is free for any use, including a competition, and its limits (10 GB per database,
# 4 cores, ~1.4 GB buffer pool) are far above what a competitor's schema needs. Developer has every feature
# but its licence excludes anything that is not development or test - a live competition is arguably
# neither, so it is not the default.
MSSQL_PID=Express

# Server collation. FIRST BOOT ONLY, like the sa password: it is baked into the system databases and can only
# be changed by deleting the mssql-data volume, so decide before the competition. Hungarian_CI_AS uses code
# page 1250, which keeps ő and ű intact in varchar columns; the image default SQL_Latin1_General_CP1_CI_AS
# silently degrades them and turns into a marking dispute. Competitors using nvarchar are unaffected either
# way. Latin1_General_100_CI_AS_SC_UTF8 is the alternative if UTF-8 varchar is preferred to Hungarian sorting.
MSSQL_COLLATION=Hungarian_CI_AS

# The host port Traefik publishes for SQL Server. 1433 is what every client tool assumes; change it only if
# a SQL Server already runs on the machine - and note it changes the LAN side only. Containers on the
# skill-suite network still reach sql.<domain>,1433, because the Traefik entrypoint itself stays on 1433.
MSSQL_PORT=1433

# What SQL Server's own memory manager is told the machine has, in MB. It takes about 80% of this for the
# buffer pool, but under Express the edition cap of ~1.4 GB binds first, so this only starts to matter once
# MSSQL_PID is raised. It is not a container limit - that is MSSQL_CONTAINER_MEMORY below.
MSSQL_MEMORY_LIMIT_MB=2048

# The cgroup limits on the container, the thing that actually stops SQL Server fighting Postgres and the
# judge containers for RAM. Keep the memory about a gigabyte above MSSQL_MEMORY_LIMIT_MB: below that the
# kernel OOM-kills the engine rather than SQL Server trimming its caches. Express never uses more than 4 CPUs.
MSSQL_CONTAINER_MEMORY=3g
MSSQL_CONTAINER_CPUS=4

# --- Registry over plain http ------------------------------------------------------------------------------
# Gitea's container registry is served over http, and the docker daemon refuses a plain-http registry unless
# it is named as insecure. On the host that will `docker pull git.<domain>/<owner>/skill-suite`, add
#
#   { "insecure-registries": ["git.<domain>"] }
#
# to /etc/docker/daemon.json (Docker Desktop: Settings -> Docker Engine) and restart the daemon. Inside the
# stack this is already handled - the workflow configures the build environment itself.
