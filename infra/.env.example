# Copy to infra/.env and fill in. infra/.env is gitignored; nothing here is secret except the dashboard
# credential, which is why that one is required rather than defaulted.
#
# Compose reads this file because the project directory is the directory of the first -f file, so
# `docker compose -f infra/compose.yaml ...` picks up infra/.env from any working directory.
#
# Order of operations on a fresh competition machine:
#
#   1. cp infra/.env.example infra/.env && $EDITOR infra/.env
#   2. docker compose -f infra/compose.yaml up -d
#   3. create the admin user in the Gitea UI at http://git.<domain>/
#      (the runners restart-loop until step 4; that is expected)
#   4. infra/runner-token.sh
#   5. docker compose -f infra/compose.yaml up -d          # recreates the runners with the token
#   6. scripts/gitea-push.sh --url http://git.<domain> --token "$GITEA_TOKEN"

# The base name everything hangs off. Every device that should reach the stack must resolve
# git.<domain>, suite.<domain> and traefik.<domain> to THIS HOST'S LAN IP - a wildcard record on the venue
# router's DNS is the least painful way, an /etc/hosts line on each machine the fallback. The host itself
# needs them too if it will `docker pull` from the registry. Left unset everything falls back to *.localhost,
# which browsers resolve to loopback, so a single-machine setup works with no .env at all.
DOMAIN=skills.local

# The port Traefik publishes on the host. 80 is the point of the exercise; change it only if something else
# on the machine already owns it.
TRAEFIK_HTTP_PORT=80

# REQUIRED. htpasswd line(s) guarding the Traefik dashboard at http://traefik.<domain>/. Generate one with:
#
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'change-me'
#
# IMPORTANT: wrap the value in SINGLE QUOTES here, e.g.
#   TRAEFIK_DASHBOARD_USERS='admin:$2y$05$4Zz...'
# A bcrypt hash is $-separated and compose interpolates $ inside unquoted .env values, so an unquoted hash is
# silently mangled into something no password matches. Several users are comma-separated inside the quotes.
TRAEFIK_DASHBOARD_USERS=

# Written by infra/runner-token.sh, which asks the running Gitea for a fresh registration token. Leave it
# empty on the first `up -d`.
GITEA_RUNNER_REGISTRATION_TOKEN=

# How many act_runner replicas to run, 1..20. Each runner takes ONE job at a time, so this is the number of
# workflow jobs that can build in parallel. Size it against CPU and RAM rather than against optimism: a
# platform image build is a full .NET restore + publish, and twenty of them on one machine will swap.
GITEA_RUNNER_REPLICAS=1

# What a `runs-on:` value maps to. The default gives workflows `ubuntu-latest`, executed in Gitea's runner
# image, which already carries git, node and the common actions' dependencies.
GITEA_RUNNER_LABELS=ubuntu-latest:docker://gitea/runner-images:ubuntu-latest

# How the runner reaches Gitea. The docker network name, not the public one: it is shorter-lived DNS, it
# avoids a round trip through Traefik for every job poll, and what a workflow sees as github.server_url comes
# from Gitea's ROOT_URL regardless of this.
GITEA_RUNNER_INSTANCE_URL=http://gitea:3000

# --- Registry over plain http ------------------------------------------------------------------------------
# Gitea's container registry is served over http, and the docker daemon refuses a plain-http registry unless
# it is named as insecure. On the host that will `docker pull git.<domain>/<owner>/skill-suite`, add
#
#   { "insecure-registries": ["git.<domain>"] }
#
# to /etc/docker/daemon.json (Docker Desktop: Settings -> Docker Engine) and restart the daemon. Inside the
# stack this is already handled - the workflow configures the build environment itself.
