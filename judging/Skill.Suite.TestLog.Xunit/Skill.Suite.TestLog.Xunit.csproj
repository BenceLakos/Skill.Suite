<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Skill.Suite.TestLog.Xunit</RootNamespace>
    <AssemblyName>Skill.Suite.TestLog.Xunit</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Skill.Suite.TestLog.Xunit</PackageId>

    <!--
      It references xunit but is a library, not a test project. Without this a solution-wide `dotnet test`
      tries to launch a test host against it and reports a spurious failure.
    -->
    <IsTestProject>false</IsTestProject>
    <Description>xUnit harness for Skill Suite judgement suites: LoggedTest, FixtureScope, TestLog assert wrappers, call-logging proxy and ServiceResolver.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skill.Suite.TestLog\Skill.Suite.TestLog.csproj" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    TimedCall's abandoned-call tally is process-wide static state, so its tests have to read and reset it.
    Precedent: ServiceResolver.Reset exists for the same reason, only as public API.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Skill.Suite.TestLog.Tests" />
  </ItemGroup>

</Project>
