{
  "stryker-config": {
    "project": "Checkout.Rules.Services/Checkout.Rules.Services.csproj",
    "test-projects": ["Checkout.Rules.UnitTests/Checkout.Rules.UnitTests.csproj"],
    "solution": "Checkout.Rules.sln",
    "reporters": ["json"],
