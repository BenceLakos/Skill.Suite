{
  "protocol": 1,

  // Black-box scoring parts. Leave empty for a white-box session, where marks come from aspects and the judge
  // never runs the marker. Declare a part per component for a black-box session so a competitor can see which
  // area their suite neglected: { "id": "services", "include": ["**/Services/**"] }
  //
  // Parts are the SCORING granularity, and the only one. Separately and unconditionally, the black-box judge
  // also measures coverage and mutation for each of the competitor's test CLASSES - that needs no declaration
  // here and produces no marks.
  "parts": [],

  // Only used by the black-box composite. The defaults are documented in the marker's README; these are the
  // dials to turn if every suite lands at the same score.
  "scoring": {
    "coverageFloor": 30,
    "coverageCeil": 95,
    "mutationFloor": 20,
    "mutationCeil": 90,
    "coverageWeight": 0.30,
    "coreWeight": 0.70
  },

  // One row per [Aspect] id in the hidden suite. Declaring them all is what makes an aspect nobody attempted
  // show up as a "no" row in `skill-marker report` instead of silently vanishing.
  "aspects": [
    { "id": "A1.1", "label": "Add: two positives" },
    { "id": "A1.2", "label": "Add: negatives" },
    { "id": "A2.1", "label": "Divide: by non-zero" },
    { "id": "A2.2", "label": "Divide: by zero returns the sentinel" },
    { "id": "A3.1", "label": "Describe: non-null" }
  ]
}
