# syntax=docker/dockerfile:1.6
#
# Black-box judge image for SkillSuite.Session (S4).
#
# Inverted from white-box: the reference implementation is baked in and the COMPETITOR supplies the test
# suite. Their SkillSuite.Session.UnitTests folder replaces the placeholder, and the suite is measured -
# coverage of the reference implementation, and how many injected faults it kills - rather than marked against
# expectations.
#
#   ./pack-contracts.sh && ./build-image.sh blackbox
#
# As with the white-box image, everything session-specific is declared here rather than passed as build args.
#
# This image contains the reference implementation IN SOURCE FORM, because Stryker has to mutate it. That
# makes it the most sensitive artifact in the system: private registry only, immutable tags only, never public
# CI.

ARG BASE_IMAGE=JUDGE_BASE_IMAGE_DEFAULT
ARG MARKER_VERSION=1.0.0

# ---------------------------------------------------------------------------- build

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

ENV DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    NUGET_XMLDOC_MODE=skip

WORKDIR /src

COPY SkillSuite.Session.sln ./
COPY nuget.config ./
COPY local-nuget/ local-nuget/
COPY */*.csproj ./
RUN for proj in *.csproj; do \
        dir="${proj%.csproj}"; \
        mkdir -p "$dir"; \
        mv "$proj" "$dir/"; \
    done

RUN dotnet restore "SkillSuite.Session.sln"

COPY . .

# The reference implementation is compiled in, and its sources stay - Stryker mutates them at run time.
RUN dotnet build "SkillSuite.Session.Services/SkillSuite.Session.Services.csproj" -c Release --no-restore

# The competitor's suite is what gets swapped in, so the shipped sample suite must not be baked in: it would
# survive as a fallback and inflate an empty submission's score.
RUN if find "/src/SkillSuite.Session.UnitTests" -name '*.cs' -print -quit | grep -q .; then \
        echo "FIREWALL: sample test sources found in SkillSuite.Session.UnitTests; check Dockerfile.blackbox.dockerignore" >&2; \
        exit 1; \
    fi \
    && if [ -d /src/_design ]; then \
        echo "FIREWALL: _design/ is present in the image; check the dockerignore" >&2; exit 1; \
    fi

# ---------------------------------------------------------------------------- runtime

FROM ${BASE_IMAGE}

ARG MARKER_VERSION

ENV JUDGE_SOLUTION=SkillSuite.Session.sln \
    JUDGE_SWAP_SRC=SkillSuite.Session.UnitTests \
    JUDGE_TEST_PROJECT=SkillSuite.Session.UnitTests/SkillSuite.Session.UnitTests.csproj \
    JUDGE_APP_DIR=/app \
    JUDGE_MARKING_MAP=/app/marking-map.json \
    JUDGE_FAIL_ON_RED=false \
    JUDGE_EMIT_ASPECT_REPORT=false \
    # Stryker re-runs the whole suite once per mutant, so it needs far more than the per-step budget.
    JUDGE_MUTATION_TIMEOUT_SECONDS=900 \
    PATH="${PATH}:/root/.dotnet/tools"

WORKDIR /app

COPY --from=build /src/ /app/
COPY --from=build /root/.nuget/packages/ /root/.nuget/packages/

# Both tools are installed at build time so the run needs no network. --add-source points at the baked feed,
# so this works before the packages are published: drop the .nupkg files into local-nuget/.
RUN dotnet tool install --global --add-source /app/local-nuget Skill.Suite.Marker --version ${MARKER_VERSION} \
    && dotnet tool install --global dotnet-stryker \
    && skill-marker version

COPY marking-map.json /app/marking-map.json
COPY stryker-config.json /app/stryker-config.json
COPY docker-entrypoint.sh /usr/local/bin/judge-blackbox.sh
RUN chmod 0755 /usr/local/bin/judge-blackbox.sh

ENTRYPOINT ["/usr/local/bin/judge-blackbox.sh"]
