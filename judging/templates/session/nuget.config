<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      clear first: the judge restores with explicit source flags on the command line, and this file must not
      reintroduce a remote feed behind them. It is also why swap_dir refuses to copy a submission's own
      nuget.config. The local path is relative to this file, so it resolves both on a developer machine and
      at /app inside the image.
    -->
    <clear />
    <add key="session-local" value="./local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
