@inject ITranslator T

<MudNavMenu Class="mt-2">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        @T["nav.home"]
    </MudNavLink>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudDivider Class="my-2"/>
            <MudNavLink Href="sessions" Icon="@Icons.Material.Filled.EventNote">
                @T["nav.sessions"]
            </MudNavLink>
            <MudNavLink Href="competitors" Icon="@Icons.Material.Filled.Groups">
                @T["nav.competitors"]
            </MudNavLink>
            <MudNavLink Href="experts" Icon="@Icons.Material.Filled.School">
                @T["nav.experts"]
            </MudNavLink>
            <MudNavLink Href="credentials" Icon="@Icons.Material.Filled.VpnKey">
                @T["nav.credentials"]
            </MudNavLink>
            <MudNavLink Href="docker-images" Icon="@Icons.Material.Filled.Memory">
                @T["nav.dockerImages"]
            </MudNavLink>
            <MudNavLink Href="starter-packages" Icon="@Icons.Material.Filled.Inventory2">
                @T["nav.starterPackages"]
            </MudNavLink>
            <MudNavLink Href="test-runs" Icon="@Icons.Material.Filled.PlayCircleFilled">
                @T["nav.testRuns"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Competitor">
        <Authorized>
            <MudDivider Class="my-2"/>
            <MudNavLink Href="my-test-runs" Icon="@Icons.Material.Filled.PlayCircleFilled">
                @T["nav.myTestRuns"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
