@inject ISender Mediator
@inject ISnackbar Snackbar
@inject ITranslator T

@using Skill.Suite.Application.Competitors.CreateCompetitor
@using Skill.Suite.Application.Competitors.GetCompetitor
@using Skill.Suite.Application.Competitors.UpdateCompetitor

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudForm @ref="_form" Model="_model" Class="d-flex flex-column gap-3">
                <MudTextField @bind-Value="_model.Username"
                              Label="@T["competitors.field.username"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              MaxLength="120"/>

                <MudTextField @bind-Value="_model.FullName"
                              Label="@T["competitors.field.fullName"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              MaxLength="200"/>

                <MudTextField @bind-Value="_model.Password"
                              Label="@T["competitors.field.password"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              AdornmentAriaLabel="@(_showPassword ? T["competitors.hidePassword"] : T["competitors.showPassword"])"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                              HelperText="@T["competitors.help.password"]"
                              MaxLength="256"/>

                <MudTextField @bind-Value="_model.IpAddress"
                              Label="@T["competitors.field.ipAddress"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              MaxLength="45"/>

                @* Optional: most competitions hand out no second device, and one is never required. *@
                <MudTextField @bind-Value="_model.MobileIpAddress"
                              Label="@T["competitors.field.mobileIpAddress"]"
                              Variant="Variant.Outlined"
                              HelperText="@T["competitors.help.mobileIpAddress"]"
                              Clearable="true"
                              MaxLength="45"/>

                <MudTextField @bind-Value="_model.CountryCode"
                              Label="@T["competitors.field.countryCode"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              MaxLength="3"
                              Mask="@(new RegexMask("^[A-Za-z]{0,3}$"))"
                              Style="text-transform:uppercase;"/>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_submitting">@T["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? Id { get; set; }

    private MudForm _form = null!;
    private FormModel _model = new();
    private bool _loading;
    private bool _submitting;
    private bool _showPassword;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue) return;

        _loading = true;
        var result = await Mediator.Send(new GetCompetitorByIdQuery(Id.Value));
        if (result.IsSuccess)
        {
            var c = result.Value;
            _model = new FormModel
            {
                Username = c.Username,
                FullName = c.FullName,
                Password = c.Password,
                IpAddress = c.IpAddress,
                MobileIpAddress = c.MobileIpAddress,
                CountryCode = c.CountryCode,
            };
        }
        else
        {
            _error = result.Error.Message;
        }
        _loading = false;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        _error = null;

        if (Id.HasValue)
        {
            var cmd = new UpdateCompetitorCommand(
                Id.Value, _model.Username, _model.FullName, _model.Password,
                _model.IpAddress, _model.MobileIpAddress, _model.CountryCode);
            var result = await Mediator.Send(cmd);
            if (result.IsFailure) { _error = result.Error.Message; _submitting = false; return; }
        }
        else
        {
            var cmd = new CreateCompetitorCommand(
                _model.Username, _model.FullName, _model.Password,
                _model.IpAddress, _model.MobileIpAddress, _model.CountryCode);
            var result = await Mediator.Send(cmd);
            if (result.IsFailure) { _error = result.Error.Message; _submitting = false; return; }
        }

        Snackbar.Add(T["common.success.saved"], Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class FormModel
    {
        public string Username { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string IpAddress { get; set; } = string.Empty;
        public string? MobileIpAddress { get; set; }
        public string CountryCode { get; set; } = string.Empty;
    }
}
