@page "/credentials"
@attribute [Authorize(Roles = "Admin")]
@inject ISender Mediator
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ITranslator T

@using Skill.Suite.Application.Credentials
@using Skill.Suite.Application.Credentials.DeleteCredential
@using Skill.Suite.Application.Credentials.ListCredentials
@using Skill.Suite.Domain.Credentials

<PageTitle>@T["credentials.title"]</PageTitle>

<PageHeader Title="@T["credentials.title"]" Subtitle="@T["credentials.subtitle"]">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">
            @T["credentials.create"]
        </MudButton>
    </Actions>
</PageHeader>

<MudDataGrid T="CredentialDto"
             Elevation="1"
             Items="_items"
             Loading="_loading"
             QuickFilter="QuickFilter"
             Hover="true"
             SortMode="SortMode.Multiple"
             Filterable="false">
        <ToolBarContent>
            <MudTextField @bind-Value="_search"
                          Placeholder="@T["common.search"]"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mt-0" Style="max-width:320px;"/>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@T["credentials.field.name"]"/>
            <TemplateColumn Title="@T["credentials.field.kind"]" Sortable="false">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@KindColor(context.Item.Kind)">
                        @KindLabel(context.Item.Kind)
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@T["common.actions"]" Sortable="false" CellStyle="text-align:right">
                <CellTemplate>
                    <MudTooltip Text="@T["common.edit"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context.Item))"/>
                    </MudTooltip>
                    <MudTooltip Text="@T["common.delete"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Item))"/>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4" Color="Color.Secondary">@T["common.noResults"]</MudText>
        </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="CredentialDto"/>
    </PagerContent>
</MudDataGrid>

@code {
    private List<CredentialDto> _items = [];
    private bool _loading;
    private string? _search;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        var result = await Mediator.Send(new ListCredentialsQuery(null, null));
        _items = result.IsSuccess ? result.Value : [];
        _loading = false;
    }

    private Func<CredentialDto, bool> QuickFilter => x =>
        string.IsNullOrWhiteSpace(_search)
        || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private async Task OpenCreate()
    {
        var dialog = await Dialogs.ShowAsync<CredentialFormDialog>(T["credentials.create"]);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task OpenEdit(CredentialDto item)
    {
        var parameters = new DialogParameters { ["Id"] = item.Id };
        var dialog = await Dialogs.ShowAsync<CredentialFormDialog>(T["credentials.edit"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false }) await Load();
    }

    private async Task Delete(CredentialDto item)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = T["credentials.deleteConfirmTitle"],
            Message = T.Format("credentials.deleteConfirm", item.Name),
            YesText = T["common.delete"],
            CancelText = T["common.cancel"],
        });
        if (ok != true) return;

        var result = await Mediator.Send(new DeleteCredentialCommand(item.Id));
        if (result.IsSuccess)
        {
            Snackbar.Add(T["common.success.deleted"], Severity.Success);
            await Load();
        }
        else
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
        }
    }

    private string KindLabel(CredentialKind kind) => kind switch
    {
        CredentialKind.Gitea => T["credentials.kind.gitea"],
        CredentialKind.Nexus => T["credentials.kind.nexus"],
        CredentialKind.Postgres => T["credentials.kind.postgres"],
        CredentialKind.MySql => T["credentials.kind.mysql"],
        CredentialKind.MsSql => T["credentials.kind.mssql"],
        _ => kind.ToString(),
    };

    private Color KindColor(CredentialKind kind) => kind switch
    {
        CredentialKind.Gitea => Color.Tertiary,
        CredentialKind.Nexus => Color.Info,
        CredentialKind.Postgres => Color.Primary,
        CredentialKind.MySql => Color.Primary,
        CredentialKind.MsSql => Color.Primary,
        _ => Color.Default,
    };
}
