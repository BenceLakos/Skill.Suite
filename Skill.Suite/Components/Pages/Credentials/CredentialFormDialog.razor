@inject ISender Mediator
@inject ISnackbar Snackbar
@inject ITranslator T

@using Skill.Suite.Application.Credentials.CreateCredential
@using Skill.Suite.Application.Credentials.GetCredential
@using Skill.Suite.Application.Credentials.UpdateCredential
@using Skill.Suite.Domain.Credentials

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"/>
        }
        else
        {
            <MudForm @ref="_form" Model="_model" Class="d-flex flex-column gap-3">
                <MudTextField @bind-Value="_model.Name"
                              Label="@T["credentials.field.name"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              MaxLength="120"/>

                <MudSelect T="CredentialKind" @bind-Value="_model.Kind"
                           Label="@T["credentials.field.kind"]"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@CredentialKind.Gitea">@T["credentials.kind.gitea"]</MudSelectItem>
                    <MudSelectItem Value="@CredentialKind.Nexus">@T["credentials.kind.nexus"]</MudSelectItem>
                    <MudSelectItem Value="@CredentialKind.Postgres">@T["credentials.kind.postgres"]</MudSelectItem>
                    <MudSelectItem Value="@CredentialKind.MySql">@T["credentials.kind.mysql"]</MudSelectItem>
                    <MudSelectItem Value="@CredentialKind.MsSql">@T["credentials.kind.mssql"]</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_model.Secret"
                              Label="@T["credentials.field.secret"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@T["common.required"]"
                              InputType="@(_showSecret ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showSecret ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              AdornmentAriaLabel="@(_showSecret ? T["credentials.hideSecret"] : T["credentials.showSecret"])"
                              OnAdornmentClick="@(() => _showSecret = !_showSecret)"
                              HelperText="@T["credentials.help.secret"]"
                              Lines="3"
                              MaxLength="4096"/>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_submitting">@T["common.save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid? Id { get; set; }

    private MudForm _form = null!;
    private FormModel _model = new();
    private bool _loading;
    private bool _submitting;
    private bool _showSecret;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Id.HasValue) return;

        _loading = true;
        var result = await Mediator.Send(new GetCredentialByIdQuery(Id.Value));
        if (result.IsSuccess)
        {
            var c = result.Value;
            _model = new FormModel
            {
                Name = c.Name,
                Kind = c.Kind,
                Secret = c.Secret,
            };
        }
        else
        {
            _error = result.Error.Message;
        }
        _loading = false;
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        _error = null;

        if (Id.HasValue)
        {
            var result = await Mediator.Send(new UpdateCredentialCommand(Id.Value, _model.Name, _model.Kind, _model.Secret));
            if (result.IsFailure) { _error = result.Error.Message; _submitting = false; return; }
        }
        else
        {
            var result = await Mediator.Send(new CreateCredentialCommand(_model.Name, _model.Kind, _model.Secret));
            if (result.IsFailure) { _error = result.Error.Message; _submitting = false; return; }
        }

        Snackbar.Add(T["common.success.saved"], Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public CredentialKind Kind { get; set; } = CredentialKind.Gitea;
        public string Secret { get; set; } = string.Empty;
    }
}
