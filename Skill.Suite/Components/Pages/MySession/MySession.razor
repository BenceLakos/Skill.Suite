@page "/my-session"
@attribute [Authorize(Roles = Roles.Competitor)]
@inject ISender Mediator
@inject NavigationManager Nav
@inject ITranslator T

@using Skill.Suite.Application.Authorization
@using Skill.Suite.Application.Sessions.MySession
@using Skill.Suite.Domain.Sessions

<PageTitle>@T["mySession.title"]</PageTitle>

<PageHeader Title="@T["mySession.title"]" Subtitle="@T["mySession.subtitle"]"/>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="ma-4"/>
}
else if (_overview is null)
{
    <MudAlert Severity="Severity.Error">@(_error ?? T["common.error"])</MudAlert>
}
else
{
    @* Taken into a local so the null check below narrows for everything that follows it. *@
    var session = _overview.Session;

    <MudStack Spacing="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@T["mySession.credentials"]</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <CopyableField Label="@T["mySession.field.username"]"
                                   Value="@_overview.Credentials.Username"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <CopyableField Label="@T["mySession.field.password"]"
                                   Value="@_overview.Credentials.Password"
                                   Secret="true"/>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
                @T["mySession.credentials.help"]
            </MudText>
        </MudPaper>

        @if (session is null && _overview.NotEnrolled)
        {
            <MudAlert Severity="Severity.Warning">@T["mySession.notEnrolled"]</MudAlert>
        }
        else if (session is null)
        {
            <MudAlert Severity="Severity.Info">@T["mySession.noActiveSession"]</MudAlert>
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-3">
                    <MudText Typo="Typo.h6" Style="flex:1;">@session.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(session.Status)">
                        @T[$"sessions.status.{session.Status.ToString().ToLowerInvariant()}"]
                    </MudChip>
                </MudStack>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@T["sessions.field.startsAt"]</MudText>
                        <MudText Typo="Typo.body2">@session.StartsAt.ToString(TimestampFormat)</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@T["sessions.field.endsAt"]</MudText>
                        <MudText Typo="Typo.body2">@session.EndsAt.ToString(TimestampFormat)</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@T["mySession.repository"]</MudText>
                @if (string.IsNullOrWhiteSpace(session.RepositoryUrl))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        @T["mySession.repository.unavailable"]
                    </MudAlert>
                }
                else
                {
                    <CopyableField Label="@T["mySession.field.repositoryUrl"]" Value="@session.RepositoryUrl"/>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
                        @T["mySession.repository.help"]
                    </MudText>
                }
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">@T["mySession.database"]</MudText>

                @if (session.Database.Server is null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
                        @T["mySession.database.noServer"]
                    </MudAlert>
                }

                <MudGrid Spacing="3">
                    @if (session.Database.Server is not null)
                    {
                        <MudItem xs="12" md="6">
                            <CopyableField Label="@T["mySession.field.server"]" Value="@session.Database.Server"/>
                        </MudItem>
                    }
                    <MudItem xs="12" md="6">
                        <CopyableField Label="@T["mySession.field.login"]" Value="@session.Database.Login"/>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <CopyableField Label="@T["mySession.field.databasePassword"]"
                                       Value="@session.Database.Password"
                                       Secret="true"/>
                    </MudItem>

                    @if (session.Database.SessionDatabase is null)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @T["mySession.database.noSessionDatabase"]
                            </MudText>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" md="6">
                            <CopyableField Label="@T["mySession.field.sessionDatabase"]"
                                           Value="@session.Database.SessionDatabase"/>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@T["mySession.field.access"]</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                         Color="@AccessColor(session.Database.SessionReadAccess)">
                                    @T["sessions.field.databaseRead"]
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                         Color="@AccessColor(session.Database.SessionWriteAccess)">
                                    @T["sessions.field.databaseWrite"]
                                </MudChip>
                            </MudStack>
                        </MudItem>
                        @if (session.Database.SessionConnectionString is not null)
                        {
                            <MudItem xs="12">
                                <CopyableField Label="@T["mySession.field.sessionConnectionString"]"
                                               Value="@session.Database.SessionConnectionString"
                                               Secret="true"/>
                            </MudItem>
                        }
                    }
                </MudGrid>

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3">
                    @T["mySession.database.help"]
                </MudText>
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6">@T["mySession.services"]</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T["mySession.services.mine"]</MudText>

                @if (session.Services.Count == 0)
                {
                    <MudText Color="Color.Secondary" Class="mt-3">@T["mySession.services.empty"]</MudText>
                }
                else
                {
                    <MudStack Spacing="3" Class="mt-3">
                        @*
                            The name and nothing else. A competitor opens it or copies it; everything the
                            container was built from is the administrator's business, and a published host
                            port printed beside the name would be a second address for the same container
                            that skips the proxy.
                        *@
                        @foreach (var service in session.Services)
                        {
                            <MudPaper Outlined="true" Class="pa-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Secondary"/>
                                    <MudLink Href="@service.Url" Target="_blank" Typo="Typo.body1">
                                        @service.Domain
                                    </MudLink>
                                </MudStack>

                                <CopyableField Label="@T["mySession.service.url"]" Value="@service.Domain"/>

                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    @T["mySession.service.urlHelp"]
                                </MudText>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudPaper>
        }
    </MudStack>
}

@code {
    private const string TimestampFormat = "yyyy-MM-dd HH:mm";

    private MySessionOverviewDto? _overview;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // The host the competitor reached this page on. It is the one thing the handler cannot work out for
        // itself, and both the SQL Server name and the git clone URL are derived from it.
        var result = await Mediator.Send(new GetMySessionOverviewQuery(RequestHost()));

        if (result.IsSuccess)
            _overview = result.Value;
        else
            _error = result.Error.Message;

        _loading = false;
    }

    private string? RequestHost() =>
        Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out var baseUri) ? baseUri.Host : null;

    private static Color StatusColor(SessionStatus status) => status switch
    {
        SessionStatus.Active => Color.Success,
        SessionStatus.Stopped => Color.Warning,
        SessionStatus.Closed => Color.Dark,
        _ => Color.Default,
    };

    private static Color AccessColor(bool granted) => granted ? Color.Success : Color.Default;
}
