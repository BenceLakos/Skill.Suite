@page "/"
@inject ITranslator T
@inject NavigationManager Nav

<PageTitle>@T["nav.home"]</PageTitle>

<MudStack Spacing="6">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h3">@T["home.welcome"]</MudText>
        <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@T["home.subtitle"]</MudText>
    </MudStack>

    <AuthorizeView Roles="Admin">
        <MudGrid Spacing="4">
            <Tile Title="@T["nav.sessions"]" Body="@T["home.tile.sessions.body"]" Href="sessions" Icon="@Icons.Material.Filled.EventNote"/>
            <Tile Title="@T["nav.competitors"]" Body="@T["home.tile.competitors.body"]" Href="competitors" Icon="@Icons.Material.Filled.Groups"/>
            <Tile Title="@T["nav.experts"]" Body="@T["home.tile.experts.body"]" Href="experts" Icon="@Icons.Material.Filled.School"/>
            <Tile Title="@T["nav.credentials"]" Body="@T["home.tile.credentials.body"]" Href="credentials" Icon="@Icons.Material.Filled.VpnKey"/>
            <Tile Title="@T["nav.dockerImages"]" Body="@T["home.tile.dockerImages.body"]" Href="docker-images" Icon="@Icons.Material.Filled.Memory"/>
            <Tile Title="@T["nav.starterPackages"]" Body="@T["home.tile.starterPackages.body"]" Href="starter-packages" Icon="@Icons.Material.Filled.Inventory2"/>
        </MudGrid>
    </AuthorizeView>
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var state = await AuthState;
        if (state.User.IsInRole("Competitor"))
            Nav.NavigateTo("my-test-runs", replace: true);
    }
}
