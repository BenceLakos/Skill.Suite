@page "/sessions/new"
@page "/sessions/{Id:guid}"
@attribute [Authorize(Roles = "Admin")]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ITranslator T

@using System.Text.RegularExpressions
@using Skill.Suite.Application.Credentials
@using Skill.Suite.Application.Credentials.ListCredentials
@using Skill.Suite.Application.DockerImages.ListSessionImageOptions
@using Skill.Suite.Application.Sessions.CreateSession
@using Skill.Suite.Application.Sessions.GetSession
@using Skill.Suite.Application.Sessions.UpdateSession
@using Skill.Suite.Application.StarterPackages.ListStarterPackages
@using Skill.Suite.Application.StarterPackages.ListStarterPackageSqlFiles
@using Skill.Suite.Components.Pages.Sessions.Drafts
@using Skill.Suite.Domain.Credentials
@using Skill.Suite.Domain.Sessions

<PageTitle>@(IsEdit ? T["sessions.edit"] : T["sessions.create"])</PageTitle>

<MudStack Spacing="0" Class="mb-3">
    <MudText Typo="Typo.h5">@(IsEdit ? T["sessions.edit"] : T["sessions.create"])</MudText>
    <MudText Typo="Typo.body2" Class="text-muted">@T["sessions.edit.subtitle"]</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <MudForm @ref="_form" Model="_model">
      <MudPaper Elevation="1" Class="session-edit-card">
        <MudTabs Elevation="0" Border="false" KeepPanelsAlive="true" MinimumTabWidth="120px" Class="session-edit-tabs">
            <MudTabPanel Text="@T["sessions.section.general"]" Class="pa-0 pt-4">
                <MudStack Spacing="3">
                    <LabeledField Label="@T["sessions.field.name"]">
                        <MudTextField @bind-Value="_model.Name"
                                      Variant="Variant.Outlined"
                                      Required="true" RequiredError="@T["common.required"]" MaxLength="200"/>
                    </LabeledField>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
                            <LabeledField Label="@T["sessions.field.startsAt"]">
                                <MudTextField @bind-Value="_model.StartsAt"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.DateTimeLocal" Required="true"/>
                            </LabeledField>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <LabeledField Label="@T["sessions.field.endsAt"]">
                                <MudTextField @bind-Value="_model.EndsAt"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.DateTimeLocal" Required="true"/>
                            </LabeledField>
                        </MudItem>
                    </MudGrid>

                    <LabeledField Label="@T["sessions.field.description"]" Help="@T["sessions.help.description"]">
                        <MarkdownEditor @bind-Value="_model.Description"/>
                    </LabeledField>

                    @if (IsEdit)
                    {
                        @*
                            Status is shown, not edited — the update command no longer carries it at all.
                            Setting it here bypassed every guarded transition: picking Active provisioned
                            nothing — no organisation, no repositories, no webhook, no secret — leaving a
                            session that looks live and judges nothing, and picking Closed cancelled no
                            in-flight run. Start, Stop and Close on the sessions list are the only ways in,
                            because they are the only ones that do the work the status implies.
                        *@
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <LabeledField Label="@T["sessions.field.status"]">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                             Color="@(_model.Status switch {
                                                 SessionStatus.Active => Color.Success,
                                                 SessionStatus.Draft => Color.Warning,
                                                 SessionStatus.Stopped => Color.Info,
                                                 _ => Color.Dark })">
                                        @T[$"sessions.status.{_model.Status.ToString().ToLowerInvariant()}"]
                                    </MudChip>
                                    <MudText Typo="Typo.caption" Class="d-block mt-1" Color="Color.Secondary">
                                        @T["sessions.help.statusReadOnly"]
                                    </MudText>
                                </LabeledField>
                            </MudItem>
                        </MudGrid>
                    }
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="@T["sessions.section.resources"]" Class="pa-0 pt-4">
                <MudStack Spacing="3">
                    @*
                        Free text with suggestions rather than a picker: the folder only has to be readable
                        by the application container, and a session can legitimately point at one that was
                        mounted in rather than uploaded to the starter packages volume.
                    *@
                    <LabeledField Label="@T["sessions.field.templateFolder"]" Help="@T["sessions.help.templateFolder"]">
                        <MudAutocomplete T="string" @bind-Value="_model.TemplateFolder"
                                         Variant="Variant.Outlined" MaxLength="1000"
                                         SearchFunc="SearchTemplateFolders"
                                         CoerceText="true" CoerceValue="true"
                                         ResetValueOnEmptyText="false"
                                         Clearable="true"/>
                    </LabeledField>
                    @*
                        Same shape as the template folder above, and for the same reason: the registry
                        listing is a suggestion, not the set of legal answers. A judge image can live on a
                        registry this application has no credential for, and a session saved before an image
                        was renamed must still show what it actually points at.
                    *@
                    <LabeledField Label="@T["sessions.field.judgementImage"]" Help="@T["sessions.help.judgementImage"]">
                        <MudAutocomplete T="string" @bind-Value="_model.JudgementImage"
                                         Variant="Variant.Outlined" MaxLength="500"
                                         SearchFunc="SearchImages"
                                         CoerceText="true" CoerceValue="true"
                                         ResetValueOnEmptyText="false"
                                         Clearable="true"/>
                    </LabeledField>
                    @RegistryWarning()

                    <LabeledField Label="@T["sessions.field.gitCredential"]"
                                  Help="@T["sessions.help.gitCredential"]">
                        <MudSelect T="Guid?" @bind-Value="_model.GitCredentialId"
                                   Variant="Variant.Outlined" Clearable="true">
                            @foreach (var c in _giteaCredentials)
                            {
                                <MudSelectItem T="Guid?" Value="@c.Id">@c.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </LabeledField>

                    <LabeledField Label="@T["sessions.field.judgementImagePullCredential"]"
                                  Help="@T["sessions.help.judgementImagePullCredential"]">
                        <MudSelect T="Guid?" @bind-Value="_model.JudgementImagePullCredentialId"
                                   Variant="Variant.Outlined" Clearable="true">
                            @foreach (var c in _nexusCredentials)
                            {
                                <MudSelectItem T="Guid?" Value="@c.Id">@c.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </LabeledField>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="@T["sessions.section.database"]" Class="pa-0 pt-4">
                <MudStack Spacing="3">
                    @*
                        A base name, not a database. Provisioning creates one database per competitor from
                        it, so the field is capped at what leaves room for a username inside SQL Server's
                        128-character identifier limit.
                    *@
                    <LabeledField Label="@T["sessions.field.databaseName"]"
                                  Help="@T["sessions.help.databaseName"]">
                        <MudTextField @bind-Value="_model.DatabaseName"
                                      Variant="Variant.Outlined" MaxLength="64"/>
                    </LabeledField>
                    <LabeledField Label="@T["sessions.field.databaseAccess"]"
                                  Help="@T["sessions.help.databaseAccess"]">
                        <MudStack Row="true" Spacing="6">
                            <MudCheckBox T="bool" @bind-Value="_model.DatabaseReadAccess"
                                         Label="@T["sessions.field.databaseRead"]" Dense="true"/>
                            <MudCheckBox T="bool" @bind-Value="_model.DatabaseWriteAccess"
                                         Label="@T["sessions.field.databaseWrite"]" Dense="true"/>
                        </MudStack>
                    </LabeledField>

                    @*
                        A picker rather than the free text the template folder uses, and deliberately: this
                        file is read back through the starter package store when the session starts, so a
                        path that is not on the volume can never be right. The one entry the volume does not
                        account for is whatever this session already points at: it is added to the list on
                        load, so an unrelated edit cannot quietly clear a script whose file was removed.
                    *@
                    <LabeledField Label="@T["sessions.field.databaseSeedScript"]"
                                  Help="@T["sessions.help.databaseSeedScript"]">
                        <MudSelect T="string" @bind-Value="_model.DatabaseSeedScript"
                                   Variant="Variant.Outlined" Clearable="true" Dense="true">
                            @foreach (var script in _seedScripts)
                            {
                                <MudSelectItem T="string" Value="@script">@script</MudSelectItem>
                            }
                        </MudSelect>
                    </LabeledField>
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="@T["sessions.section.dockerImages"]" Class="pa-0 pt-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @T.Format("sessions.dockerImages.count", _model.DockerImages.Count)
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddDockerImage">
                        @T["sessions.dockerImages.add"]
                    </MudButton>
                </MudStack>

                @RegistryWarning()

                @if (_model.DockerImages.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        @T["sessions.dockerImages.empty"]
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="2">
                        @for (var i = 0; i < _model.DockerImages.Count; i++)
                        {
                            var idx = i;
                            <DockerImageCard Image="_model.DockerImages[idx]"
                                             AvailableImages="_availableImages"
                                             OnRemove="@(() => RemoveDockerImage(idx))"/>
                        }
                    </MudStack>
                }
            </MudTabPanel>
        </MudTabs>

        <div class="session-edit-footer">
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Outlined" Size="Size.Medium" Href="sessions">
                    @T["common.cancel"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium"
                           OnClick="Submit" Disabled="_submitting" StartIcon="@Icons.Material.Filled.Save">
                    @(IsEdit ? T["sessions.update"] : T["sessions.createConfirm"])
                </MudButton>
            </MudStack>
        </div>
      </MudPaper>
    </MudForm>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private MudForm _form = null!;
    private SessionFormDraft _model = new();
    private List<string> _availableImages = [];
    private List<string> _templateFolders = [];
    private List<string> _seedScripts = [];
    private List<CredentialDto> _giteaCredentials = [];
    private List<CredentialDto> _nexusCredentials = [];
    private bool _loading = true;
    private bool _submitting;
    private string? _error;
    private string? _registryWarning;

    protected override async Task OnInitializedAsync()
    {
        var imageOptions = await Mediator.Send(new ListSessionImageOptionsQuery());
        if (imageOptions.IsSuccess)
        {
            _availableImages = [.. imageOptions.Value.Images];
            _registryWarning = imageOptions.Value.RegistryWarning;
        }

        // Packages without a competitor-start folder are still offered, last: the folder may simply not have
        // been uploaded yet, and a session cannot be started until it is there anyway.
        var starterPackages = await Mediator.Send(new ListStarterPackagesQuery());
        _templateFolders = starterPackages.IsSuccess
            ?
            [
                .. starterPackages.Value
                    .OrderByDescending(p => p.HasCompetitorStart)
                    .ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                    .Select(p => p.TemplateFolder),
            ]
            : [];

        // Every .sql file on the volume, wherever it sits in its package: a seed script is as likely to be
        // in a db/ or seed/ folder as beside the starter kit, and the session only ever runs one of them.
        var sqlFiles = await Mediator.Send(new ListStarterPackageSqlFilesQuery());
        _seedScripts = sqlFiles.IsSuccess ? [.. sqlFiles.Value.Select(file => file.RelativePath)] : [];

        var gitea = await Mediator.Send(new ListCredentialsQuery(CredentialKind.Gitea, null));
        _giteaCredentials = gitea.IsSuccess ? gitea.Value : [];

        // The judgement-image pull credential can be either kind. Session images live in the private Gitea
        // registry, which serves NuGet and OCI from the same host and the same account, so an operator
        // reasonably stores that credential as Gitea. Offering only Nexus forced them to file it under a
        // label that does not describe it.
        var nexus = await Mediator.Send(new ListCredentialsQuery(CredentialKind.Nexus, null));
        _nexusCredentials =
        [
            .. nexus.IsSuccess ? nexus.Value : [],
            .. _giteaCredentials,
        ];

        if (IsEdit)
        {
            var result = await Mediator.Send(new GetSessionByIdQuery(Id!.Value));
            if (result.IsSuccess)
            {
                _model = LoadDraftFrom(result.Value);

                if (!string.IsNullOrWhiteSpace(_model.DatabaseSeedScript)
                    && !_seedScripts.Contains(_model.DatabaseSeedScript))
                {
                    _seedScripts.Add(_model.DatabaseSeedScript);
                }
            }
            else
            {
                _error = result.Error.Message;
            }
        }

        _loading = false;
    }

    // Shown above both image pickers rather than once at the top of the form: the operator only needs to know
    // the list is short when they are looking at the list.
    private RenderFragment? RegistryWarning()
    {
        if (string.IsNullOrWhiteSpace(_registryWarning))
            return null;

        return @<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                   @T.Format("sessions.images.registryUnavailable", _registryWarning)
               </MudAlert>;
    }

    private Task<IEnumerable<string>> SearchImages(string? value, CancellationToken cancellationToken) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? _availableImages.AsEnumerable()
            : _availableImages.Where(image => image.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private Task<IEnumerable<string>> SearchTemplateFolders(string? value, CancellationToken cancellationToken) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? _templateFolders.AsEnumerable()
            : _templateFolders.Where(folder => folder.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void AddDockerImage() =>
        _model.DockerImages.Add(new DockerImageDraft
        {
            Image = _availableImages.FirstOrDefault() ?? string.Empty,
        });

    private void RemoveDockerImage(int index)
    {
        if (index >= 0 && index < _model.DockerImages.Count)
            _model.DockerImages.RemoveAt(index);
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        _error = null;

        var startsAt = DateTime.SpecifyKind(_model.StartsAt, DateTimeKind.Utc);
        var endsAt = DateTime.SpecifyKind(_model.EndsAt, DateTimeKind.Utc);
        var dockerImages = _model.DockerImages.Select(ToDomain).ToList();

        if (IsEdit)
        {
            var cmd = new UpdateSessionCommand(
                Id!.Value, _model.Name, _model.Description, startsAt, endsAt,
                _model.TemplateFolder, _model.JudgementImage,
                _model.DatabaseName, _model.DatabaseReadAccess, _model.DatabaseWriteAccess,
                _model.DatabaseSeedScript,
                _model.GitCredentialId, _model.JudgementImagePullCredentialId,
                dockerImages);
            var result = await Mediator.Send(cmd);
            if (result.IsFailure) { _error = result.Error.Message; _submitting = false; return; }
        }
        else
        {
            var slug = GenerateSlug(_model.Name);
            var cmd = new CreateSessionCommand(
                _model.Name, slug, _model.Description, startsAt, endsAt,
                _model.TemplateFolder, _model.JudgementImage,
                _model.DatabaseName, _model.DatabaseReadAccess, _model.DatabaseWriteAccess,
                _model.DatabaseSeedScript,
                _model.GitCredentialId, _model.JudgementImagePullCredentialId,
                dockerImages);
            var result = await Mediator.Send(cmd);
            if (result.IsFailure) { _error = result.Error.Message; _submitting = false; return; }
        }

        Snackbar.Add(T["common.success.saved"], Severity.Success);
        Nav.NavigateTo("sessions");
    }

    private static string GenerateSlug(string name)
    {
        var slug = Regex.Replace(name.Trim().ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
        return string.IsNullOrEmpty(slug) ? Guid.NewGuid().ToString("N")[..8] : slug;
    }

    private static SessionFormDraft LoadDraftFrom(Skill.Suite.Application.Sessions.SessionDto dto) => new()
    {
        Name = dto.Name,
        Slug = dto.Slug,
        Description = dto.Description,
        StartsAt = DateTime.SpecifyKind(dto.StartsAt, DateTimeKind.Unspecified),
        EndsAt = DateTime.SpecifyKind(dto.EndsAt, DateTimeKind.Unspecified),
        Status = dto.Status,
        TemplateFolder = dto.TemplateFolder,
        JudgementImage = dto.JudgementImage,
        DatabaseName = dto.DatabaseName,
        DatabaseReadAccess = dto.DatabaseReadAccess,
        DatabaseWriteAccess = dto.DatabaseWriteAccess,
        DatabaseSeedScript = dto.DatabaseSeedScript,
        GitCredentialId = dto.GitCredentialId,
        JudgementImagePullCredentialId = dto.JudgementImagePullCredentialId,
        DockerImages = dto.DockerImages.Select(d => new DockerImageDraft
        {
            Image = d.Image,
            Env = d.Env.Select(kv => new KeyValueDraft { Key = kv.Key, Value = kv.Value }).ToList(),
            Labels = d.Labels.Select(kv => new KeyValueDraft { Key = kv.Key, Value = kv.Value }).ToList(),
            Volumes = d.Volumes.Select(v => new VolumeDraft { HostPath = v.HostPath, ContainerPath = v.ContainerPath, ReadOnly = v.ReadOnly }).ToList(),
            PortMappings = d.PortMappings.Select(p => new PortMappingDraft { HostPort = p.HostPort, ContainerPort = p.ContainerPort, Protocol = p.Protocol }).ToList(),
        }).ToList(),
    };

    private static SessionDockerImage ToDomain(DockerImageDraft draft) => new(
        draft.Image.Trim(),
        draft.Env.Where(kv => !string.IsNullOrWhiteSpace(kv.Key)).ToDictionary(kv => kv.Key.Trim(), kv => kv.Value ?? string.Empty),
        draft.Labels.Where(kv => !string.IsNullOrWhiteSpace(kv.Key)).ToDictionary(kv => kv.Key.Trim(), kv => kv.Value ?? string.Empty),
        draft.Volumes.Where(v => !string.IsNullOrWhiteSpace(v.HostPath) && !string.IsNullOrWhiteSpace(v.ContainerPath))
            .Select(v => new VolumeMount(v.HostPath.Trim(), v.ContainerPath.Trim(), v.ReadOnly)).ToList(),
        draft.PortMappings.Select(p => new PortMapping(p.HostPort, p.ContainerPort, p.Protocol)).ToList());
}
