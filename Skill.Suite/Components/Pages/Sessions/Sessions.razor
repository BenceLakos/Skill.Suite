@page "/sessions"
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@inject ISender Mediator
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ITranslator T

@using Skill.Suite.Application.Sessions
@using Skill.Suite.Application.Sessions.CloseSession
@using Skill.Suite.Application.Sessions.ListSessionCompetitors
@using Skill.Suite.Application.Sessions.StartMarking
@using Skill.Suite.Application.Sessions.StartSession
@using Skill.Suite.Application.Sessions.StopMarking
@using Skill.Suite.Application.Sessions.StopSession
@using Skill.Suite.Application.Sessions.ListSessions
@using Skill.Suite.Domain.Sessions

<PageTitle>@T["sessions.title"]</PageTitle>

<PageHeader Title="@T["sessions.title"]" Subtitle="@T["sessions.subtitle"]">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="sessions/new">
            @T["sessions.create"]
        </MudButton>
    </Actions>
</PageHeader>

@*
    Inline rather than a modal dialog: both operations are resumable and the admin has nothing to decide
    while one runs, so a dialog would only take the session list away from them for a minute. Sitting above
    the grid, the bar stays visible next to the rows whose buttons it has disabled.
*@
@if (Busy)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            @T.Format(BusyTitleKey, _busyName)
        </MudText>
        <ProvisioningProgress Label="@ProgressLabel"
                              Completed="@(_progress?.Completed ?? 0)"
                              Total="@(_progress?.Total ?? 0)"
                              Indeterminate="@(_progress?.IsIndeterminate ?? true)"/>
    </MudPaper>
}

@*
    Where to connect, printed once a competitor's marking is up, and kept for every competitor started so
    far. Inline and dismissable rather than a modal: an expert reads these off while moving between machines,
    and a dialog would take the session list away from them for the whole of it.
*@
@if (_markingRuns.Count > 0)
{
    <MudPaper Outlined="true" Class="pa-4 mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.subtitle2">@T.Format("sessions.marking.endpoints", _markingName)</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           OnClick="@(() => _markingRuns.Clear())"/>
        </MudStack>
        <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0">
            <thead>
            <tr>
                <th>@T["sessions.marking.competitor"]</th>
                <th>@T["sessions.marking.ipAddress"]</th>
                <th>@T["sessions.marking.service"]</th>
                <th>@T["sessions.marking.url"]</th>
                <th>@T["sessions.marking.container"]</th>
                <th>@T["sessions.marking.ports"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var run in _markingRuns)
            {
                @foreach (var endpoint in run.Endpoints)
                {
                    <tr>
                        <td>@run.CompetitorUsername</td>
                        <td>@run.MarkingIpAddress</td>
                        <td>@endpoint.ServiceNumber — @endpoint.Image</td>
                        <td>
                            @if (endpoint.Url is null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@T["sessions.marking.noUrl"]</MudText>
                            }
                            else
                            {
                                <MudLink Href="@endpoint.Url" Target="_blank">@endpoint.Url</MudLink>
                            }
                        </td>
                        <td>@endpoint.ContainerName</td>
                        <td>
                            @(endpoint.Ports.Count == 0
                                ? T["sessions.marking.noPorts"]
                                : string.Join(", ", endpoint.Ports.Select(
                                    p => $"{p.HostPort}→{p.ContainerPort}/{p.Protocol.ToString().ToLowerInvariant()}")))
                        </td>
                    </tr>
                }
            }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

<MudDataGrid T="SessionDto"
             Elevation="1"
             Items="_items"
             Loading="_loading"
             QuickFilter="QuickFilter"
             Hover="true"
             SortMode="SortMode.Multiple"
             Filterable="false">
        <ToolBarContent>
            <MudTextField @bind-Value="_search"
                          Placeholder="@T["common.search"]"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mt-0" Style="max-width:320px;"/>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@T["sessions.field.name"]"/>
            <PropertyColumn Property="x => x.Slug" Title="@T["sessions.field.slug"]"/>
            <PropertyColumn Property="x => x.StartsAt" Title="@T["sessions.field.startsAt"]" Format="yyyy-MM-dd HH:mm"/>
            <PropertyColumn Property="x => x.EndsAt" Title="@T["sessions.field.endsAt"]" Format="yyyy-MM-dd HH:mm"/>
            <TemplateColumn Title="@T["sessions.field.status"]" Sortable="false">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)" Variant="Variant.Filled">
                        @StatusLabel(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@T["common.actions"]" Sortable="false" CellStyle="text-align:right">
                <CellTemplate>
                    <MudTooltip Text="@T["common.edit"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"sessions/{context.Item.Id}")"/>
                    </MudTooltip>
                    @*
                        One forward action per status, so the button on a row always says what happens next.
                        An active session is stopped rather than started again: repairing a partial start is
                        Stop then Start, which withdraws what the half-finished run left behind before
                        redoing it, instead of provisioning over the top of it.
                    *@
                    @if (context.Item.Status is SessionStatus.Draft or SessionStatus.Stopped)
                    {
                        <MudTooltip Text="@(context.Item.Status == SessionStatus.Draft
                                              ? T["sessions.action.start"]
                                              : T["sessions.action.restart"])">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                           Color="Color.Success" Disabled="@Busy"
                                           OnClick="@(() => Start(context.Item))"/>
                        </MudTooltip>
                    }
                    else if (context.Item.Status == SessionStatus.Active)
                    {
                        <MudTooltip Text="@T["sessions.action.stop"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small"
                                           Color="Color.Warning" Disabled="@Busy"
                                           OnClick="@(() => Stop(context.Item))"/>
                        </MudTooltip>
                    }
                    @if (context.Item.Status != SessionStatus.Closed)
                    {
                        <MudTooltip Text="@T["sessions.action.close"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small"
                                           Disabled="@Busy" OnClick="@(() => Close(context.Item))"/>
                        </MudTooltip>
                    }
                    else
                    {
                        @*
                            Marking belongs to a closed session and only to one: the competition containers
                            are gone by then, so the marking copies can take the host ports they published,
                            and nothing an expert connects to can be reopened underneath them.
                        *@
                        <MudTooltip Text="@T["sessions.action.marking"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Grading" Size="Size.Small"
                                           Color="Color.Info" Disabled="@Busy"
                                           OnClick="@(() => OpenMarking(context.Item))"/>
                        </MudTooltip>
                        <MudTooltip Text="@T["sessions.action.stopAllMarking"]">
                            <MudIconButton Icon="@Icons.Material.Filled.LayersClear" Size="Size.Small"
                                           Disabled="@Busy" OnClick="@(() => StopMarking(context.Item, null))"/>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-4" Color="Color.Secondary">@T["common.noResults"]</MudText>
        </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="SessionDto"/>
    </PagerContent>
</MudDataGrid>

@code {
    private List<SessionDto> _items = [];
    private bool _loading;
    private bool _starting;
    private bool _stopping;
    private bool _marking;
    private string? _search;
    private string _busyName = string.Empty;
    private string _markingName = string.Empty;

    /// <summary>
    /// One entry per competitor whose marking has been started from this page, newest last.
    /// </summary>
    /// <remarks>
    /// Accumulated rather than replaced: several competitors are marked at once, from several machines, and
    /// an expert who started the second one still needs the first one's addresses in front of them.
    /// </remarks>
    private readonly List<StartMarkingResult> _markingRuns = [];
    private SessionProvisioningProgress? _progress;
    private RendererProgress<SessionProvisioningProgress>? _progressSink;

    /// <summary>
    /// Whether a start, a stop or a marking run is in progress. One at a time: they all talk to the same
    /// git host and docker daemon about the same session, and they share the single progress panel above
    /// the grid.
    /// </summary>
    private bool Busy => _starting || _stopping || _marking;

    protected override async Task OnInitializedAsync() => await Load();

    /// <summary>
    /// Stops the running command, if any, from reporting into a component that no longer exists — the admin
    /// navigating away does not cancel it, and it keeps going on the server until it is done.
    /// </summary>
    public void Dispose() => _progressSink?.Dispose();

    private async Task Load()
    {
        _loading = true;
        var result = await Mediator.Send(new ListSessionsQuery(null, null));
        _items = result.IsSuccess ? result.Value : [];
        _loading = false;
    }

    private Func<SessionDto, bool> QuickFilter => x =>
        string.IsNullOrWhiteSpace(_search)
        || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || x.Slug.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private async Task Close(SessionDto session)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = T["sessions.closeConfirmTitle"],
            Message = T["sessions.closeConfirm"],
            YesText = T["common.confirm"],
            CancelText = T["common.cancel"],
        });
        if (ok != true) return;

        var result = await Mediator.Send(new CloseSessionCommand(session.Id));
        if (result.IsFailure)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        var outcome = result.Value;

        Snackbar.Add(
            outcome.ServicesRemoved > 0
                ? T.Format("sessions.closedServices", outcome.ServicesRemoved)
                : T["common.success.closed"],
            Severity.Success);

        // The session is closed either way — this says the containers outlived it, which is the admin's to
        // clear up and invisible from this page.
        if (outcome.ServiceRemovalError is not null)
            Snackbar.Add(T.Format("sessions.closeServicesFailed", outcome.ServiceRemovalError), Severity.Warning);

        await Load();
    }

    /// <summary>
    /// Starts a session: opens it for submissions and provisions a repository per competitor.
    /// </summary>
    /// <remarks>
    /// Provisioning runs inside this request rather than on a background queue, so the button stays busy for
    /// as long as the git host takes — a few seconds per competitor. That is deliberate for now: the admin
    /// finds out here whether every repository was created, instead of discovering at the start of the
    /// competition that a queued job failed silently. It is the piece to move to a worker first if a
    /// session ever has enough competitors to outlast the request.
    /// </remarks>
    private async Task Start(SessionDto session)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = T["sessions.startConfirmTitle"],
            Message = string.Format(T["sessions.startConfirm"], session.GitOrganization),
            YesText = T["common.confirm"],
            CancelText = T["common.cancel"],
        });
        if (ok != true) return;

        _starting = true;
        _busyName = session.Name;
        _progress = null;

        // Disposed in the finally block AND in Dispose: the command keeps reporting for as long as it runs,
        // whether this page is still on screen or not.
        _progressSink = new RendererProgress<SessionProvisioningProgress>(
            InvokeAsync,
            report =>
            {
                _progress = report;
                StateHasChanged();
            });

        try
        {
            var result = await Mediator.Send(new StartSessionCommand(session.Id, _progressSink));
            if (result.IsFailure)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
                return;
            }

            var outcome = result.Value;
            if (outcome.FullySucceeded)
            {
                Snackbar.Add(
                    string.Format(T["sessions.started"], outcome.Provisioned, outcome.Organization),
                    Severity.Success);
            }
            else
            {
                // Partial success is the interesting case and must not read as failure: the competitors who
                // did get a repository can start work while the rest are fixed and Start is re-run.
                Snackbar.Add(
                    string.Format(T["sessions.startedPartially"],
                        outcome.Provisioned, outcome.Failed.Count,
                        string.Join(", ", outcome.Failed.Select(f => f.Subject))),
                    Severity.Warning);

                foreach (var failure in outcome.Failed)
                    Snackbar.Add($"{StageLabel(failure.Stage)}: {failure.Subject}: {failure.Error}", Severity.Error);
            }

            // Reported separately from the repositories, and only for what the session is configured with:
            // a session with no database or no services would otherwise read as having silently skipped them.
            if (!string.IsNullOrWhiteSpace(session.DatabaseName))
            {
                Snackbar.Add(
                    string.Format(T["sessions.started.databases"],
                        outcome.DatabaseAccessGranted, session.DatabaseName),
                    Severity.Info);
            }

            if (session.DockerImages.Count > 0)
            {
                Snackbar.Add(
                    string.Format(T["sessions.started.services"], outcome.ServicesRunning),
                    Severity.Info);
            }

            // Skipped is not failed: nothing was attempted for these competitors, because they have no
            // account on the system in question and work they cannot reach is worse than none. Still shown,
            // and shown separately, because otherwise a session reads as fully provisioned while some
            // competitors have nowhere to push or no way into the database.
            if (outcome.SkippedNoGitAccess.Count > 0)
            {
                Snackbar.Add(
                    string.Format(T["sessions.startedSkipped"],
                        outcome.SkippedNoGitAccess.Count,
                        string.Join(", ", outcome.SkippedNoGitAccess)),
                    Severity.Warning);
            }

            if (outcome.SkippedNoDatabaseLogin.Count > 0)
            {
                Snackbar.Add(
                    string.Format(T["sessions.startedSkippedDatabase"],
                        outcome.SkippedNoDatabaseLogin.Count,
                        string.Join(", ", outcome.SkippedNoDatabaseLogin)),
                    Severity.Warning);
            }

            await Load();
        }
        catch (Exception ex)
        {
            // Provisioning talks to a git host, and only the per-competitor step returns a Result — creating the
            // organisation, seeding the template repository and installing the webhook all throw. An unhandled
            // exception here tears down the Blazor circuit, so the operator saw the page die with no message and
            // no way to tell a partial Start from a clean one. Enrolment rows are saved as each competitor is
            // decided, so re-running Start after fixing the cause retries only what did not get through.
            Snackbar.Add(string.Format(T["sessions.startFailed"], ex.Message), Severity.Error);
            await Load();
        }
        finally
        {
            _progressSink?.Dispose();
            _progressSink = null;
            _progress = null;
            _busyName = string.Empty;
            _starting = false;
        }
    }

    /// <summary>
    /// Stops a session: closes it to pushes, takes the competitors' repository access away and stops the
    /// session's docker services.
    /// </summary>
    /// <remarks>
    /// Runs inside this request for the same reason Start does — the admin finds out here whether every
    /// competitor was actually locked out, rather than trusting a queued job to have managed it.
    /// </remarks>
    private async Task Stop(SessionDto session)
    {
        var ok = await Dialogs.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = T["sessions.stopConfirmTitle"],
            Message = T["sessions.stopConfirm"],
            YesText = T["common.confirm"],
            CancelText = T["common.cancel"],
        });
        if (ok != true) return;

        _stopping = true;
        _busyName = session.Name;
        _progress = null;

        _progressSink = new RendererProgress<SessionProvisioningProgress>(
            InvokeAsync,
            report =>
            {
                _progress = report;
                StateHasChanged();
            });

        try
        {
            var result = await Mediator.Send(new StopSessionCommand(session.Id, _progressSink));
            if (result.IsFailure)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
                return;
            }

            var outcome = result.Value;
            if (outcome.FullySucceeded)
            {
                Snackbar.Add(
                    string.Format(T["sessions.stopped"], outcome.AccessRevoked, outcome.ServicesStopped),
                    Severity.Success);
            }
            else
            {
                // The session is stopped either way, which is why this is a warning: what is left is a
                // competitor who can still push or a container still running, both named below.
                Snackbar.Add(
                    string.Format(T["sessions.stoppedPartially"],
                        outcome.Failed.Count,
                        string.Join(", ", outcome.Failed.Select(f => f.Subject))),
                    Severity.Warning);

                foreach (var failure in outcome.Failed)
                    Snackbar.Add($"{StageLabel(failure.Stage)}: {failure.Subject}: {failure.Error}", Severity.Error);
            }

            await Load();
        }
        catch (Exception ex)
        {
            // Same circuit safety as Start: the git host calls throw, and an unhandled exception here tears
            // the Blazor circuit down with no message at all. The status is committed before anything
            // external is touched, so the session is stopped even when this is reached.
            Snackbar.Add(string.Format(T["sessions.stopFailed"], ex.Message), Severity.Error);
            await Load();
        }
        finally
        {
            _progressSink?.Dispose();
            _progressSink = null;
            _progress = null;
            _busyName = string.Empty;
            _stopping = false;
        }
    }

    /// <summary>
    /// Asks which competitor is being marked and from which machine, then does it.
    /// </summary>
    /// <remarks>
    /// A dialog rather than a confirmation, because marking needs a value nothing on the platform knows: the
    /// address of the computer the expert is sitting at. That address is the whole of what makes the
    /// service's domain lead to this competitor's container rather than somebody else's.
    /// </remarks>
    private async Task OpenMarking(SessionDto session)
    {
        var competitors = await Mediator.Send(new ListSessionCompetitorsQuery(session.Id));
        if (competitors.IsFailure)
        {
            Snackbar.Add(competitors.Error.Message, Severity.Error);
            return;
        }

        if (competitors.Value.Count == 0)
        {
            Snackbar.Add(T["sessions.marking.noCompetitors"], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<MarkingDialog>
        {
            { dialog => dialog.Competitors, competitors.Value },
        };

        var dialog = await Dialogs.ShowAsync<MarkingDialog>(T["sessions.marking.title"], parameters);
        var result = await dialog.Result;

        if (result?.Canceled != false || result.Data is not MarkingRequest request)
            return;

        if (request.Action == MarkingAction.Stop)
        {
            await StopMarking(session, request.CompetitorId);
            return;
        }

        await StartMarking(session, request);
    }

    /// <summary>
    /// Starts one competitor's marking containers for the machine the dialog named.
    /// </summary>
    /// <remarks>
    /// Runs inside this request like Start and Stop, and for the same reason: the expert finds out here
    /// whether there is anything to mark against, rather than trusting a queued job to have managed it.
    /// </remarks>
    private async Task StartMarking(SessionDto session, MarkingRequest request)
    {
        _marking = true;
        _busyName = session.Name;
        _progress = null;

        _progressSink = new RendererProgress<SessionProvisioningProgress>(
            InvokeAsync,
            report =>
            {
                _progress = report;
                StateHasChanged();
            });

        try
        {
            var result = await Mediator.Send(new StartMarkingCommand(
                session.Id, request.CompetitorId, request.MarkingIpAddress, _progressSink));

            if (result.IsFailure)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
                return;
            }

            var outcome = result.Value;

            _markingName = session.Name;
            _markingRuns.RemoveAll(run => run.CompetitorUsername == outcome.CompetitorUsername);
            _markingRuns.Add(outcome);

            Snackbar.Add(
                string.Format(T["sessions.markingStarted"],
                    outcome.ServicesRunning, outcome.CompetitorUsername, outcome.MarkingIpAddress),
                outcome.FullySucceeded ? Severity.Success : Severity.Warning);

            foreach (var failure in outcome.Failed)
                Snackbar.Add($"{StageLabel(failure.Stage)}: {failure.Subject}: {failure.Error}", Severity.Error);

            if (outcome.DatabaseServicesSkipped)
            {
                Snackbar.Add(
                    string.Format(T["sessions.markingSkippedDatabase"], outcome.CompetitorUsername),
                    Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            // Same circuit safety as Start: an unhandled exception here tears the Blazor circuit down with
            // no message at all, and marking is re-runnable, so the repair is to press the button again.
            Snackbar.Add(string.Format(T["sessions.markingFailed"], ex.Message), Severity.Error);
        }
        finally
        {
            _progressSink?.Dispose();
            _progressSink = null;
            _progress = null;
            _busyName = string.Empty;
            _marking = false;
        }
    }

    /// <summary>
    /// Removes one competitor's marking containers, or every one of the session's.
    /// </summary>
    /// <remarks>
    /// Per competitor is the ordinary case and the safe one: an expert finishing with one competitor must
    /// not take down another expert's run, which is exactly what stopping the whole session's would do.
    /// </remarks>
    private async Task StopMarking(SessionDto session, Guid? competitorId)
    {
        var result = await Mediator.Send(new StopMarkingCommand(session.Id, competitorId));
        if (result.IsFailure)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        var outcome = result.Value;

        if (outcome.CompetitorUsername is null)
            _markingRuns.Clear();
        else
            _markingRuns.RemoveAll(run => run.CompetitorUsername == outcome.CompetitorUsername);

        Snackbar.Add(
            string.Format(T["sessions.markingStopped"],
                outcome.ServicesRemoved, outcome.CompetitorUsername ?? T["sessions.marking.everyone"]),
            Severity.Success);

        // Nothing else was touched — this says the containers outlived the request, which is the admin's to
        // clear up on the docker host and invisible from this page.
        if (outcome.ServiceRemovalError is not null)
            Snackbar.Add(T.Format("sessions.markingStopFailed", outcome.ServiceRemovalError), Severity.Warning);
    }

    /// <summary>Which of the three running commands the progress panel is titled after.</summary>
    private string BusyTitleKey => _marking
        ? "sessions.progress.markSession"
        : _stopping
            ? "sessions.progress.stopSession"
            : "sessions.progress.session";

    /// <summary>
    /// The stage the command is reporting, in the admin's words. Before the first report arrives the command
    /// is loading the session and resolving credentials, which is still work worth naming.
    /// </summary>
    private string ProgressLabel => _progress is null
        ? BusyLabel
        : _progress.Stage switch
        {
            SessionProvisioningStage.Preparing => T["sessions.progress.preparing"],
            SessionProvisioningStage.Repositories => T.Format("sessions.progress.repositories",
                _progress.Completed, _progress.Total, _progress.Percent),
            SessionProvisioningStage.Databases => T.Format("sessions.progress.databases",
                _progress.Completed, _progress.Total, _progress.Percent),
            SessionProvisioningStage.DockerServices => T.Format("sessions.progress.dockerServices",
                _progress.Completed, _progress.Total, _progress.Percent),
            SessionProvisioningStage.MarkingServices => T.Format("sessions.progress.markingServices",
                _progress.Completed, _progress.Total, _progress.Percent),
            SessionProvisioningStage.RepositoryAccess => T.Format("sessions.progress.revokingAccess",
                _progress.Completed, _progress.Total, _progress.Percent),
            SessionProvisioningStage.StoppingServices => T.Format("sessions.progress.stoppingServices",
                _progress.Completed, _progress.Total, _progress.Percent),
            _ => BusyLabel,
        };

    /// <summary>What to say while the running command has not reported a stage it can be named by.</summary>
    private string BusyLabel => _marking
        ? T["sessions.progress.marking"]
        : _stopping
            ? T["sessions.progress.stopping"]
            : T["sessions.progress.starting"];

    /// <summary>The stage a failure came from, short enough to prefix the subject it happened to.</summary>
    private string StageLabel(SessionProvisioningStage stage) => stage switch
    {
        SessionProvisioningStage.Repositories => T["sessions.stage.repositories"],
        SessionProvisioningStage.Databases => T["sessions.stage.databases"],
        SessionProvisioningStage.DockerServices => T["sessions.stage.dockerServices"],
        SessionProvisioningStage.MarkingServices => T["sessions.stage.markingServices"],
        SessionProvisioningStage.RepositoryAccess => T["sessions.stage.repositoryAccess"],
        SessionProvisioningStage.StoppingServices => T["sessions.stage.stoppingServices"],
        _ => stage.ToString(),
    };

    private Color StatusColor(SessionStatus status) => status switch
    {
        SessionStatus.Active => Color.Success,
        SessionStatus.Draft => Color.Warning,
        SessionStatus.Stopped => Color.Info,
        SessionStatus.Closed => Color.Dark,
        _ => Color.Default,
    };

    private string StatusLabel(SessionStatus status) => status switch
    {
        SessionStatus.Draft => T["sessions.status.draft"],
        SessionStatus.Active => T["sessions.status.active"],
        SessionStatus.Stopped => T["sessions.status.stopped"],
        SessionStatus.Closed => T["sessions.status.closed"],
        _ => status.ToString(),
    };
}
