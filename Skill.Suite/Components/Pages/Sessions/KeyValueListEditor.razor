@using Skill.Suite.Components.Pages.Sessions.Drafts
@inject ITranslator T

<MudStack Spacing="1">
    @for (var i = 0; i < Items.Count; i++)
    {
        var idx = i;
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudTextField T="string" @bind-Value="Items[idx].Key"
                          Variant="Variant.Outlined"
                          Placeholder="@KeyLabel" Style="flex:1;"/>
            <MudTextField T="string" @bind-Value="Items[idx].Value"
                          Variant="Variant.Outlined"
                          Placeholder="@ValueLabel" Style="flex:2;"/>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Items.RemoveAt(idx))"/>
        </MudStack>
    }
    <div>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Items.Add(new KeyValueDraft()))">
            @T["common.add"]
        </MudButton>
    </div>
</MudStack>

@code {
    [Parameter, EditorRequired] public List<KeyValueDraft> Items { get; set; } = [];
    [Parameter] public string KeyLabel { get; set; } = "Key";
    [Parameter] public string ValueLabel { get; set; } = "Value";
}
