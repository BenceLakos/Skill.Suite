@inject ISender Mediator
@inject ISnackbar Snackbar
@inject ITranslator T

@using Skill.Suite.Application.DockerImages.PushDockerImage

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @T.Format("dockerImages.push.message", ImageName)
            </MudText>

            <MudForm @ref="_form">
                <MudTextField @bind-Value="_tag"
                              Label="@T["dockerImages.push.tag"]"
                              Variant="Variant.Outlined"
                              Required="true" RequiredError="@T["common.required"]"
                              HelperText="@T["dockerImages.push.tagHelp"]"
                              MaxLength="128"/>
            </MudForm>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T["common.cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="Submit" Disabled="_submitting">
            @T["dockerImages.push.confirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter, EditorRequired] public string ImageName { get; set; } = string.Empty;

    private MudForm _form = null!;
    private string _tag = string.Empty;
    private bool _submitting;
    private string? _error;

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;

        _submitting = true;
        _error = null;

        var result = await Mediator.Send(new PushDockerImageCommand(Id, _tag));
        if (result.IsFailure)
        {
            _error = result.Error.Message;
            _submitting = false;
            return;
        }

        Snackbar.Add(T.Format("dockerImages.push.success", $"{ImageName}:{_tag}"), Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
